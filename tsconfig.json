{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@varia/adapter-jest": ["./packages/adapters/jest/src/index.ts"],
      "@varia/*": ["./packages/*/src/index.ts"],
      "@varia/adapter-vitest": ["./packages/adapters/vitest/src/index.ts"]
    },
    "checkJs": true
  },
  "include": [
    "packages/*/src/**/*",
    "packages/*/test/**/*.ts",
    "packages/*/runtime/*.cjs",
    "packages/adapters/*/src/**/*",
    "packages/adapters/*/test/**/*.ts",
    "packages/adapters/*/runtime/*.cjs",
    "tests/**/*.ts",
    "vitest.config.ts",
    "packages/adapters/*/runtime/*.mjs"
  ],
  "exclude": ["packages/dashboard/**"]
}
