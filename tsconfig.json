{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "paths": {
      "@varia/*": ["./packages/*/src/index.ts"]
    },
    "checkJs": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/locales/*.json",
    "spike/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "spike/runtime/*.cjs"
  ]
}
