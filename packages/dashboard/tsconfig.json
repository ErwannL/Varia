{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "declaration": false,
    "paths": {
      "@varia/*": ["../*/src/index.ts"]
    },
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "test", "vite.config.ts"]
}
