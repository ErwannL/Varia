{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": { "type": "number", "const": 3 },
    "varia": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "const": "varia" },
        "version": { "type": "string" }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "root": { "type": "string" }
      },
      "required": ["id", "name", "root"],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "state": { "type": "string" },
        "partial": { "type": "boolean" },
        "mode": { "type": "string" },
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": [
        "id",
        "state",
        "partial",
        "mode",
        "seed",
        "createdAt",
        "updatedAt"
      ],
      "additionalProperties": false
    },
    "reproducibility": {
      "type": "object",
      "properties": {
        "seed": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            { "type": "null" }
          ]
        },
        "configHash": { "type": "string" },
        "envHash": { "type": "string" },
        "variaVersion": { "type": "string" },
        "gitCommit": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "gitBranch": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": [
        "seed",
        "configHash",
        "envHash",
        "variaVersion",
        "gitCommit",
        "gitBranch"
      ],
      "additionalProperties": false
    },
    "config": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "baseline": {
      "type": "object",
      "properties": {
        "tests": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "failing": { "type": "array", "items": { "type": "string" } },
        "flaky": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "testId": { "type": "string" },
              "name": { "type": "string" },
              "reasons": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["testId", "name", "reasons"],
            "additionalProperties": false
          }
        },
        "calls": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": ["tests", "passed", "failing", "flaky", "calls"],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "adapter": { "type": "string" },
        "declared": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "boolean" }
        },
        "verified": {
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["VERIFIED", "NOT_VERIFIED", "UNSUPPORTED"]
              },
              "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
            },
            "required": ["status", "reason"],
            "additionalProperties": false
          }
        },
        "verifiedAt": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "required": ["adapter", "declared", "verified", "verifiedAt"],
      "additionalProperties": false
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "possible": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "planned": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "sampled": { "type": "boolean" },
            "estimateMs": { "type": "number" }
          },
          "required": ["possible", "planned", "sampled", "estimateMs"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "counts": {
      "type": "object",
      "properties": {
        "mutations": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "handled": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "expected": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "suspicious": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "unexpected": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "crashes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "timeouts": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "infra": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "mutations",
        "handled",
        "expected",
        "passed",
        "suspicious",
        "unexpected",
        "crashes",
        "timeouts",
        "skipped",
        "infra",
        "pending"
      ],
      "additionalProperties": false
    },
    "resilienceRate": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
    "coverage": {
      "type": "object",
      "properties": {
        "targets": {
          "type": "object",
          "properties": {
            "discovered": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "observed": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "mutated": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "neverCalled": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "transitiveOnly": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "unsupported": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "discovered",
            "observed",
            "mutated",
            "neverCalled",
            "transitiveOnly",
            "unsupported"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "object",
          "properties": {
            "mutable": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "mutated": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "nonMutable": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": ["mutable", "mutated", "nonMutable"],
          "additionalProperties": false
        }
      },
      "required": ["targets", "inputs"],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
          },
          "state": { "type": "string" },
          "target": { "type": "string" },
          "title": { "type": "string" },
          "errorName": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "message": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "frame": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "count": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "mutationIds": { "type": "array", "items": { "type": "string" } },
          "replay": { "type": "string" },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "transitive": { "type": "boolean" },
          "matchedFrom": { "type": "array", "items": { "type": "string" } }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "state",
          "target",
          "title",
          "errorName",
          "message",
          "frame",
          "count",
          "mutationIds",
          "replay",
          "depth",
          "transitive",
          "matchedFrom"
        ],
        "additionalProperties": false
      }
    },
    "resolvedIssues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "state": { "type": "string" },
          "target": { "type": "string" },
          "title": { "type": "string" }
        },
        "required": ["id", "state", "target", "title"],
        "additionalProperties": false
      }
    },
    "comparedTo": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
    "baselineCoverage": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["DISABLED", "COLLECTED", "UNAVAILABLE"]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": { "type": "string" },
              "lines": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
              "statements": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "functions": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              },
              "branches": {
                "anyOf": [{ "type": "number" }, { "type": "null" }]
              }
            },
            "required": [
              "file",
              "lines",
              "statements",
              "functions",
              "branches"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": ["status", "files"],
      "additionalProperties": false
    },
    "cache": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hits": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "misses": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "contentHash": { "type": "string" }
          },
          "required": ["hits", "misses", "contentHash"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "incremental": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "base": { "type": "string" },
            "changedFiles": {
              "anyOf": [
                { "type": "array", "items": { "type": "string" } },
                { "type": "null" }
              ]
            },
            "scope": { "type": "string" }
          },
          "required": ["base", "changedFiles", "scope"],
          "additionalProperties": false
        },
        { "type": "null" }
      ]
    },
    "acceptances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "function": { "type": "string" },
          "path": { "type": "string" },
          "strategy": { "type": "string" },
          "reason": { "type": "string" },
          "owner": { "type": "string" },
          "expires": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["ACTIVE", "EXPIRED", "OBSOLETE"]
          },
          "matched": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": ["id", "source", "function", "reason", "status", "matched"],
        "additionalProperties": false
      }
    },
    "mutations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "target": { "type": "string" },
          "test": { "type": "string" },
          "path": { "type": "string" },
          "strategy": { "type": "string" },
          "depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "provenance": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["declared", "observed", "universal"]
              },
              { "type": "null" }
            ]
          },
          "original": {},
          "value": {},
          "deleted": { "type": "boolean" },
          "status": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "subtype": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "reason": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "echoPath": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
          "error": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "message": { "type": "string" }
                },
                "required": ["name", "message"],
                "additionalProperties": false
              },
              { "type": "null" }
            ]
          },
          "durationMs": { "anyOf": [{ "type": "number" }, { "type": "null" }] },
          "testDurationMs": {
            "anyOf": [{ "type": "number" }, { "type": "null" }]
          },
          "flags": { "type": "array", "items": { "type": "string" } },
          "acceptedBy": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
        },
        "required": [
          "id",
          "target",
          "test",
          "path",
          "strategy",
          "depth",
          "provenance",
          "original",
          "value",
          "deleted",
          "status",
          "subtype",
          "reason",
          "echoPath",
          "error",
          "durationMs",
          "testDurationMs",
          "flags",
          "acceptedBy"
        ],
        "additionalProperties": false
      }
    },
    "notCovered": {
      "type": "object",
      "properties": {
        "neverCalled": { "type": "array", "items": { "type": "string" } },
        "transitiveOnly": { "type": "array", "items": { "type": "string" } },
        "unsupported": { "type": "array", "items": { "type": "string" } },
        "nonMutableInputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": { "type": "string" },
              "path": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["target", "path", "reason"],
            "additionalProperties": false
          }
        },
        "flakyTests": { "type": "array", "items": { "type": "string" } },
        "skippedMutations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "reason": { "type": "string" }
            },
            "required": ["id", "reason"],
            "additionalProperties": false
          }
        },
        "pendingMutations": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "neverCalled",
        "transitiveOnly",
        "unsupported",
        "nonMutableInputs",
        "flakyTests",
        "skippedMutations",
        "pendingMutations"
      ],
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "schemaVersion",
    "varia",
    "project",
    "run",
    "reproducibility",
    "config",
    "baseline",
    "capabilities",
    "plan",
    "counts",
    "resilienceRate",
    "coverage",
    "issues",
    "resolvedIssues",
    "comparedTo",
    "baselineCoverage",
    "cache",
    "incremental",
    "acceptances",
    "mutations",
    "notCovered",
    "limitations"
  ],
  "additionalProperties": false
}
