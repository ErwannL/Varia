{
  "description": "Redaction dans la sonde avant écriture et empreinte des arguments (op serializeArgs).",
  "cases": [
    {
      "id": "redaction/champ",
      "op": "serializeArgs",
      "input": {
        "export": "createUser",
        "redact": {
          "fields": ["password"],
          "hmacKey": "cle-test"
        },
        "args": [
          {
            "email": "ada@example.org",
            "password": "hunter2"
          }
        ]
      },
      "expected": {
        "args": [
          {
            "email": "ada@example.org",
            "password": {
              "$redacted": true,
              "fingerprint": "c8c58e43fefc21999a4cdf4927050dd0995ac3198c8e8364c405448bd2936f86",
              "type": "string"
            }
          }
        ],
        "argsFingerprint": "a239b8a369a8a2b64eb8a10600237f3331fb2a5e7ae170b2daaabfc5b6dd9a40"
      }
    },
    {
      "id": "redaction/champ-casse",
      "op": "serializeArgs",
      "input": {
        "export": "createUser",
        "redact": {
          "fields": ["PASSWORD"],
          "hmacKey": "cle-test"
        },
        "args": [
          {
            "PassWord": "hunter2"
          }
        ]
      },
      "expected": {
        "args": [
          {
            "PassWord": {
              "$redacted": true,
              "fingerprint": "c8c58e43fefc21999a4cdf4927050dd0995ac3198c8e8364c405448bd2936f86",
              "type": "string"
            }
          }
        ],
        "argsFingerprint": "508147e19be4ff019c86f222a7e1659edf09004cbab640598d9d2321aa3e3f72"
      }
    },
    {
