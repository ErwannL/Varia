                  "type": "string"
                }
              ],
              ["user", "ada"]
            ]
          }
        ],
        "argsFingerprint": "93cfaa448c586ce59bf7cb09302a3f0f2c64eb9421200185a8d94bb680b61d3f"
      }
    }
