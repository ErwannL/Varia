{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": { "type": "number", "const": 1 },
    "project": {
      "default": {},
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      },
      "additionalProperties": false
    },
    "test": {
      "default": { "cwd": ".", "env": {} },
      "type": "object",
      "properties": {
        "command": { "type": "string" },
        "framework": { "type": "string", "enum": ["jest", "vitest"] },
        "cwd": { "default": ".", "type": "string" },
        "env": {
          "default": {},
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "string" }
        },
        "node_options": { "type": "string" }
      },
      "additionalProperties": false
    },
    "baseline": {
      "default": {},
      "type": "object",
      "properties": {
        "stability_runs": { "type": "integer", "minimum": 1, "maximum": 10 }
      },
      "additionalProperties": false
    },
    "targets": {
      "default": {
        "mode": "auto",
        "include": ["src/**"],
        "exclude": [],
        "depth": "direct",
        "declared": [],
        "remove": []
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "auto",
          "type": "string",
          "enum": ["declared", "auto", "hybrid"]
        },
        "include": {
          "default": ["src/**"],
          "minItems": 1,
          "type": "array",
          "items": { "type": "string" }
        },
        "exclude": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        },
        "depth": {
          "default": "direct",
          "type": "string",
          "enum": ["direct", "all"]
        },
        "declared": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        },
        "remove": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "default": { "hints": [], "skip": [], "values": {} },
      "type": "object",
      "properties": {
        "hints": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string", "pattern": "^[^#]+#arg\\d+" },
              "range": {
                "type": "array",
                "prefixItems": [{ "type": "number" }, { "type": "number" }]
              },
              "format": {
                "type": "string",
                "enum": ["email", "uuid", "url", "iso-date", "ipv4"]
              },
              "length": {
                "type": "array",
                "prefixItems": [{ "type": "number" }, { "type": "number" }]
              }
            },
            "required": ["path"],
            "additionalProperties": false
          }
        },
        "skip": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        },
        "values": {
          "default": {},
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "array", "items": {} }
        }
      },
      "additionalProperties": false
    },
    "mutations": {
      "default": {
        "mode": "normal",
        "seed": "auto",
        "combine": false,
        "per_target": {},
        "limits": {
          "total_mutations": 10000,
          "string_length": 10000,
          "array_length": 1000,
          "object_depth": 20,
          "memory_mb": 512
        }
      },
      "type": "object",
      "properties": {
        "mode": {
          "default": "normal",
          "type": "string",
          "enum": ["quick", "normal", "full"]
        },
        "per_input": { "type": "integer", "minimum": 1, "maximum": 100 },
        "strategies": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "type",
              "null",
              "undefined",
              "empty",
              "boundary",
              "size",
              "structure",
              "format",
              "encoding"
            ]
          }
        },
        "seed": {
          "default": "auto",
          "anyOf": [
            { "type": "string", "const": "auto" },
            { "type": "integer", "minimum": 0, "maximum": 4294967295 }
          ]
        },
        "combine": { "default": false, "type": "boolean", "const": false },
        "per_target": {
          "default": {},
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "limits": {
          "default": {
            "total_mutations": 10000,
            "string_length": 10000,
            "array_length": 1000,
            "object_depth": 20,
            "memory_mb": 512
          },
          "type": "object",
          "properties": {
            "total_mutations": {
              "default": 10000,
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "string_length": {
              "default": 10000,
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "array_length": {
              "default": 1000,
              "type": "integer",
              "minimum": 1,
              "maximum": 100000
            },
            "object_depth": {
              "default": 20,
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "memory_mb": {
              "default": 512,
              "type": "integer",
              "minimum": 64,
              "maximum": 16384
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "default": {
        "timeout_ms": 5000,
        "parallelism": 1,
        "isolation": "process",
        "warn_after_ms": 1800000,
        "max_output_bytes": 8388608,
        "reset": {
          "environment": true,
          "mocks": true,
          "database": "none",
          "database_command": "",
          "filesystem": "none"
        }
      },
      "type": "object",
      "properties": {
        "timeout_ms": {
          "default": 5000,
          "type": "integer",
          "minimum": 100,
          "maximum": 600000
        },
        "parallelism": { "default": 1, "type": "number", "const": 1 },
        "isolation": {
          "default": "process",
          "type": "string",
          "const": "process"
        },
        "warn_after_ms": {
          "default": 1800000,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_bytes": {
          "default": 8388608,
          "type": "integer",
          "minimum": 1024,
          "maximum": 9007199254740991
        },
        "reset": {
          "default": {
            "environment": true,
            "mocks": true,
            "database": "none",
            "database_command": "",
            "filesystem": "none"
          },
          "type": "object",
          "properties": {
            "environment": {
              "default": true,
              "type": "boolean",
              "const": true
            },
            "mocks": { "default": true, "type": "boolean", "const": true },
            "database": {
              "default": "none",
              "type": "string",
              "enum": ["none", "command"]
            },
            "database_command": { "default": "", "type": "string" },
            "filesystem": {
              "default": "none",
              "type": "string",
              "enum": ["none", "tmpdir"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "oracle": {
      "default": {
        "handled_errors": [],
        "crash_errors": ["TypeError", "ReferenceError", "RangeError"],
        "suspicious_accept": "report",
        "slow_factor": 10,
        "slow_floor_ms": 100
      },
      "type": "object",
      "properties": {
        "handled_errors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "name_pattern": { "type": "string" },
              "code": { "type": "string" },
              "status": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "message": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "crash_errors": {
          "default": ["TypeError", "ReferenceError", "RangeError"],
          "type": "array",
          "items": { "type": "string" }
        },
        "suspicious_accept": {
          "default": "report",
          "type": "string",
          "enum": ["report", "ignore"]
        },
        "slow_factor": { "default": 10, "type": "number", "minimum": 1 },
        "slow_floor_ms": {
          "default": 100,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "default": {
        "fields": [
          "password",
          "token",
          "apiKey",
          "authorization",
          "cookie",
          "secret",
          "privateKey"
        ],
        "patterns": [],
        "store_raw_values": false
      },
      "type": "object",
      "properties": {
        "fields": {
          "default": [
            "password",
            "token",
            "apiKey",
            "authorization",
            "cookie",
            "secret",
            "privateKey"
          ],
          "type": "array",
          "items": { "type": "string" }
        },
        "patterns": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        },
        "store_raw_values": {
          "default": false,
          "type": "boolean",
          "const": false
        }
      },
      "additionalProperties": false
    },
    "storage": {
      "default": { "location": "user", "retention_runs": 50 },
      "type": "object",
      "properties": {
        "path": { "type": "string" },
        "location": {
          "default": "user",
          "type": "string",
          "enum": ["user", "project"]
        },
        "retention_runs": {
          "default": 50,
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "integrity": {
      "default": { "watch_ignored": false, "ignore_for_integrity": [] },
      "type": "object",
      "properties": {
        "watch_ignored": { "default": false, "type": "boolean" },
        "ignore_for_integrity": {
          "default": [],
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "coverage": {
      "default": { "baseline": false },
      "type": "object",
      "properties": { "baseline": { "default": false, "type": "boolean" } },
      "additionalProperties": false
    },
    "incremental": {
      "default": { "on_unknown": "full" },
      "type": "object",
      "properties": {
        "on_unknown": {
          "default": "full",
          "type": "string",
          "enum": ["full", "abort"]
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "default": { "enabled": false },
      "type": "object",
      "properties": { "enabled": { "default": false, "type": "boolean" } },
      "additionalProperties": false
    },
    "ci": {
      "default": {
        "fail_on": ["CRASH", "TIMEOUT"],
        "fail_on_regression": true,
        "include_transitive": false
      },
      "type": "object",
      "properties": {
        "fail_on": {
          "default": ["CRASH", "TIMEOUT"],
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "CRASH",
              "TIMEOUT",
              "UNEXPECTED_FAILURE",
              "SUSPICIOUS_ACCEPT"
            ]
          }
        },
        "fail_on_regression": { "default": true, "type": "boolean" },
        "fail_on_new_only_against": { "type": "string" },
        "include_transitive": { "default": false, "type": "boolean" }
      },
      "additionalProperties": false
    },
    "acceptances": {
      "default": [],
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mutation_pattern": {
                "type": "object",
                "properties": {
                  "function": { "type": "string" },
                  "path": { "type": "string" },
                  "strategy": { "type": "string" }
                },
                "required": ["function"],
                "additionalProperties": false
              },
              "reason": { "type": "string" },
              "owner": { "type": "string" },
              "expires": { "type": "string" }
            },
            "required": ["mutation_pattern", "reason"],
            "additionalProperties": false
          }
        },
        {
          "type": "object",
          "properties": {
            "store": {
              "default": "file",
              "type": "string",
              "enum": ["file", "db"]
            },
            "items": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "mutation_pattern": {
                    "type": "object",
                    "properties": {
                      "function": { "type": "string" },
                      "path": { "type": "string" },
                      "strategy": { "type": "string" }
                    },
                    "required": ["function"],
                    "additionalProperties": false
                  },
                  "reason": { "type": "string" },
                  "owner": { "type": "string" },
                  "expires": { "type": "string" }
                },
                "required": ["mutation_pattern", "reason"],
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "required": ["version"],
  "additionalProperties": false
}
